# El Caddy de Ferrebress (ADR-011): sirve la aplicación, pone las cabeceras de seguridad y
# pasa /api al servidor. HTTPS lo atiende el proxy de la máquina, que le pasa la dirección
# real en X-Forwarded-For; solo se le cree a quien llega por la red local, y de la lista se toma
# la primera que no es de confianza empezando por la derecha (la que agregó el proxy), así lo que
# mande el navegador no cuenta. Al servidor le llega esa sola, ya resuelta, en X-Real-IP.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}
}

:80 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	# Lo que solo sirve en una página. Las respuestas de /api, que son JSON y no se dibujan, no lo
	# llevan: cada pedido viaja más liviano, que en el celular se paga con datos.
	@page not path /api/*
	header @page {
		# Google necesita ver de qué sitio viene el pedido del botón: a otros sitios va solo el origen.
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Permissions-Policy "camera=(self), publickey-credentials-get=(self), publickey-credentials-create=(self), geolocation=(), microphone=()"
	}
	@api path /api/*
	header @api Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	# La política de contenido: estricta para toda la aplicación, que no habla con Google. Google vive
	# solo en la página de su botón (google-button.html), dentro de un marco de la aplicación: solo
	# esa página carga lo de Google y admite estilos en línea (la única excepción aprobada), y solo
	# la aplicación puede enmarcarla.
	@googleButton path /google-button.html
	@app not path /google-button.html /api/*
	header @app {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
	}
	header @googleButton {
		Content-Security-Policy "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src https://accounts.google.com/gsi/; img-src 'self' data: https://*.googleusercontent.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		# flush_interval -1: el canal en tiempo real no acumula respuestas (ADR-003).
		reverse_proxy server:3000 {
			flush_interval -1
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Todo lo demás (las páginas, /link, el service worker, el manifiesto, los íconos) se revisa
		# siempre: así llega cada versión y nada queda guardado de más.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
