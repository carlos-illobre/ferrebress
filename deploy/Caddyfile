# El Caddy de Ferrebress (ADR-011): sirve la aplicación, pone las cabeceras de seguridad y
# pasa /api al servidor. HTTPS lo atiende el proxy de la máquina, que le pasa la dirección
# real en X-Forwarded-For; solo se le cree a quien llega por la red local.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# Google necesita ver de qué sitio viene el pedido del botón: a otros sitios va solo el origen.
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Permissions-Policy "camera=(self), publickey-credentials-get=(self), publickey-credentials-create=(self), geolocation=(), microphone=()"
		-Server
	}

	# La política de contenido: estricta para toda la aplicación. La única excepción aprobada son los
	# estilos en línea del botón de Google, que vive en su propia página (google-button.html) dentro
	# de un marco de la aplicación: solo esa página los admite, y solo la aplicación puede enmarcarla.
	@googleButton path /google-button.html
	@app not path /google-button.html
	header @app {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' https://accounts.google.com/gsi/style; frame-src 'self' https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; img-src 'self' data: blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options DENY
	}
	header @googleButton {
		Content-Security-Policy "default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src https://accounts.google.com/gsi/; img-src 'self' data: https://*.googleusercontent.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		# flush_interval -1: el canal en tiempo real no acumula respuestas (ADR-003).
		reverse_proxy server:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Las páginas, el service worker y el manifiesto se revisan siempre: así llega cada versión.
		@fresh path /index.html /google-button.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
